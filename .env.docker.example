# Env for all-in-one docker-compose.yml (Supabase + CoreEngine).
#   cp .env.docker.example .env
#   cp docker/supabase/.env.example docker/supabase/.env
#   # Set the SAME POSTGRES_PASSWORD + POSTGRES_APP_PASSWORD in both files.
#   # Copy ANON_KEY + SERVICE_ROLE_KEY from docker/supabase/.env into this file.
#   docker compose up -d
#
# Minimal Postgres-only stack: docker compose -f docker-compose.minimal.yml …
# (ignore SERVICE_ROLE_KEY / FILES_BACKEND there).

############
# Postgres (must match docker/supabase/.env for all-in-one)
############
POSTGRES_HOST=db
POSTGRES_PORT=5432
# All-in-one uses the Supabase database name `postgres`.
# Minimal compose defaults to `coreengine` if you change this only in .env.
POSTGRES_DB=postgres
POSTGRES_USER=postgres
# Superuser — db container + ensure-app-db-role bootstrap. Set a unique value.
POSTGRES_PASSWORD=
# Least-privilege role the BFF + provisioning connect as.
POSTGRES_APP_USER=coreengine_app
POSTGRES_APP_PASSWORD=
POSTGRES_BOOTSTRAP_USER=coreengine_app
POSTGRES_BOOTSTRAP_PASSWORD=
DATABASE_URL=

############
# BFF
############
PORT=4000
AUTH_BACKEND=local
# Leave empty — Docker provision / ensure-auth-jwt-secret writes a unique value.
# Do NOT reuse Supabase JWT_SECRET here (Storage/GoTrue use that separately).
AUTH_JWT_SECRET=
DIRECTUS_RUNTIME=off
RUNNING_IN_DOCKER=1
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
# Optional OIDC (Keycloak profile): docker compose -f docker-compose.keycloak.yml --profile oidc up -d
# OIDC_ENABLED=true
# OIDC_ISSUER=http://localhost:8081/realms/coreengine
# OIDC_CLIENT_ID=coreengine
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:4000/auth/oidc/callback
# OIDC_UI_ORIGIN=http://localhost:8080
# OIDC_DISPLAY_NAME=Keycloak

# File uploads (all-in-one). Copy SERVICE_ROLE_KEY from docker/supabase/.env.
FILES_BACKEND=supabase
# Inside the BFF container → Envoy gateway service name:
SUPABASE_URL=http://api-gw:8000
# Browser / host-facing URL:
SUPABASE_PUBLIC_URL=http://localhost:8000
# Same value as SERVICE_ROLE_KEY in docker/supabase/.env (demo keys match upstream example):
SERVICE_ROLE_KEY=
# Optional browser registry REST:
# VITE_SUPABASE_URL=http://localhost:8000
# VITE_SUPABASE_ANON_KEY=

############
# Vue (baked into web image; override at build time if needed)
############
VITE_DATA_SOURCE=graphql
VITE_RECORDS_SOURCE=graphql
VITE_AUTH_MODE=bff
VITE_GRAPHQL_URL=/graphql
