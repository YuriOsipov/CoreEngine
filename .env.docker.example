# Env for docker-compose.yml (Postgres service hostname "db").
#   cp .env.docker.example .env
#   cp .env.docker.example supabase/.env
#   docker compose up -d db

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=coreengine
# Set unique passwords before first `docker compose up` (compose refuses empty/unset).
# Superuser — used only by the db container (init script); the BFF never connects as it.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Least-privilege role the BFF + provisioning connect as (created on first db start).
POSTGRES_APP_USER=coreengine_app
POSTGRES_APP_PASSWORD=
# Must match POSTGRES_APP_USER / POSTGRES_APP_PASSWORD (read by crm-bff pool + migrate scripts).
POSTGRES_BOOTSTRAP_USER=coreengine_app
POSTGRES_BOOTSTRAP_PASSWORD=
# DATABASE_URL=postgresql://coreengine_app:<app-password>@db:5432/coreengine
DATABASE_URL=

# BFF
PORT=4000
AUTH_BACKEND=local
# Leave empty — `platform:provision` / ensure-auth-jwt-secret generates a unique value.
# Example placeholders are refused at BFF startup (do not paste a shared secret from docs).
AUTH_JWT_SECRET=
DIRECTUS_RUNTIME=off
# File uploads need Supabase Storage + SERVICE_ROLE_KEY (not included in this minimal compose).
# FILES_BACKEND=supabase
# SERVICE_ROLE_KEY=
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
RUNNING_IN_DOCKER=1

# Vue (baked into web image; override at build time if needed)
VITE_DATA_SOURCE=graphql
VITE_RECORDS_SOURCE=graphql
VITE_AUTH_MODE=bff
VITE_GRAPHQL_URL=/graphql
