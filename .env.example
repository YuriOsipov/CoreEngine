# Live GraphQL + BFF auth (Directus cutover complete)
VITE_DATA_SOURCE=graphql
# Optional override; defaults to VITE_DATA_SOURCE when unset
VITE_RECORDS_SOURCE=graphql
# Optional schema registry source; defaults to VITE_DATA_SOURCE (use `rest` for PostgREST)
# VITE_REGISTRY_SOURCE=graphql
VITE_AUTH_MODE=bff
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=
# BFF Storage uploads (server-only — do not use VITE_* for these).
# SUPABASE_URL=http://localhost:8000
# From local stack: docker exec supabase-envoy printenv SERVICE_ROLE_KEY
# SERVICE_ROLE_KEY=
VITE_GRAPHQL_URL=http://localhost:4000/graphql

# Hasura records backend (BFF → Hasura GraphQL; Vue stays on VITE_GRAPHQL_URL)
HASURA_GRAPHQL_URL=http://localhost:8090/v1/graphql
# Set a unique secret — do not commit real values or reuse example placeholders.
HASURA_ADMIN_SECRET=

# Directus records backend (BFF → Directus GraphQL; Vue stays on VITE_GRAPHQL_URL)
# Keep DIRECTUS_RUNTIME=off (legacy HTTP SDK refuse). Do not set VITE_DIRECTUS_TOKEN.
DIRECTUS_GRAPHQL_URL=http://localhost:8055/graphql
DIRECTUS_TOKEN=

# Cutover contract (required by npm run registry:check-cutover)
DIRECTUS_RUNTIME=off
AUTH_BACKEND=local
# Required for BFF /auth/login and /auth/refresh (HS256).
# Leave empty and run `npm run platform:provision:node` (or ensure-auth-jwt-secret),
# or set a unique ≥32-char secret. Example/placeholder values are refused at startup.
AUTH_JWT_SECRET=
# AUTH_LOCAL_LOGIN_ENABLED=true
#   Local email/password login (default on). false = SSO-only (IdP MFA cannot be bypassed via /auth/login).
# ALLOW_INSECURE_BOOTSTRAP=false
#   Known-weak bootstrap passwords (admin12345 / ChangeMeNow!, …) are refused on every BFF start.
FILES_BACKEND=supabase
# FLOWS_BACKEND=local

# Server document render caps (pdfmake/linkedom via sibling DocEngine):
# DOC_RENDER_TIMEOUT_MS=30000
# DOC_RENDER_MAX_CONCURRENCY=2
# DOC_RENDER_MAX_OUTPUT_BYTES=26214400

# OIDC SSO (external IdP — Keycloak / Auth0 / etc.). See docs/oidc-sso.md
# Local Keycloak: docker compose -f docker-compose.keycloak.yml --profile oidc up -d
# OIDC_ENABLED=false
# OIDC_ISSUER=http://localhost:8081/realms/coreengine
# OIDC_INTERNAL_ISSUER=http://keycloak:8080/realms/coreengine
# OIDC_CLIENT_ID=coreengine
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:4000/auth/oidc/callback
# OIDC_UI_ORIGIN=http://localhost:5173
# Explicit scopes (honored as-is; omit to default — includes offline_access only when OIDC_CHECK_ON_REFRESH is on)
# OIDC_SCOPES=openid profile email offline_access
# OIDC_DISPLAY_NAME=Keycloak
# OIDC_AUDIENCE=
# OIDC_JIT_PROVISION=false
# OIDC_DEFAULT_ROLE_BACKEND_ID=
# OIDC_ALLOWED_EMAIL_DOMAINS=example.com,acme.com
#   Required when OIDC_JIT_PROVISION=true (also enforced for email-link when set).
# OIDC_CHECK_ON_REFRESH=true
#   Re-check IdP userinfo on CoreEngine refresh (stores sealed IdP tokens on the CE refresh row).
# OIDC_DEACTIVATE_ON_IDP_REJECT=false
#   Also set app_users.is_active=false when IdP rejects refresh.
# OIDC_TOKEN_ENCRYPTION_KEY=
#   Recommended in production: dedicated key for sealing IdP tokens at rest.
#   If unset, derived from AUTH_JWT_SECRET — rotating the JWT secret then makes
#   existing sealed IdP tokens unreadable (treated as absent, not a 500).
# TRUST_PROXY=
#   Behind a TLS-terminating reverse proxy, set so request.protocol sees https
#   (e.g. loopback,uniquelocal). Without it, OIDC state / id_token cookies lose Secure.

# n8n ↔ BFF flows (see docs/n8n-bff-flows.md and docs/n8n/README.md)
# Prefer N8N_BASE_URL for Setup → Flows target=n8n (resolves to /webhook/ce-{key}).
# N8N_BASE_URL=http://n8n:5678
# N8N_WEBHOOK_URL=https://n8n.example/webhook/crm-flow
# N8N_WEBHOOK_SECRET=
# FLOWS_HTTP_ALLOWED_HOSTS=n8n,n8n:5678
# CRM_N8N_EMAIL=
# CRM_N8N_PASSWORD=
# ALERT_WEBHOOK_URL=
# FLOWS_TRIGGER_REQUIRE_AUTH=true
# FLOWS_TRIGGER_SERVICE_KEY=
# FLOWS_REJECT_AUTOMATION_REENTRY=true

# Legacy CMS URL/token — unused when VITE_DATA_SOURCE=graphql and DIRECTUS_RUNTIME=off
# VITE_DIRECTUS_URL=http://localhost:8055
# VITE_DIRECTUS_TOKEN=

# Platform mail only (invite, password reset, login code). Record and document email stays in n8n.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=CoreEngine <noreply@example.com>
