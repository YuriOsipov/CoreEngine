# Live GraphQL + BFF auth (Directus cutover complete)
VITE_DATA_SOURCE=graphql
# Optional override; defaults to VITE_DATA_SOURCE when unset
VITE_RECORDS_SOURCE=graphql
# Optional schema registry source; defaults to VITE_DATA_SOURCE (use `rest` for PostgREST)
# VITE_REGISTRY_SOURCE=graphql
VITE_AUTH_MODE=bff
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=
# BFF Storage uploads (DocEngine Finish attach). From local stack: docker exec supabase-envoy printenv SERVICE_ROLE_KEY
# SERVICE_ROLE_KEY=
VITE_GRAPHQL_URL=http://localhost:4000/graphql

# Hasura records backend (BFF → Hasura GraphQL; Vue stays on VITE_GRAPHQL_URL)
HASURA_GRAPHQL_URL=http://localhost:8090/v1/graphql
# Set a unique secret — do not commit real values or reuse example placeholders.
HASURA_ADMIN_SECRET=

# Directus records backend (BFF → Directus GraphQL; Vue stays on VITE_GRAPHQL_URL)
# Keep DIRECTUS_RUNTIME=off (legacy HTTP SDK refuse). Do not set VITE_DIRECTUS_TOKEN.
DIRECTUS_GRAPHQL_URL=http://localhost:8055/graphql
DIRECTUS_TOKEN=

# Cutover contract (required by npm run registry:check-cutover)
DIRECTUS_RUNTIME=off
AUTH_BACKEND=local
# Required for BFF /auth/login and /auth/refresh (HS256).
# Leave empty and run `npm run platform:provision:node` (or ensure-auth-jwt-secret),
# or set a unique ≥32-char secret. Example/placeholder values are refused at startup.
AUTH_JWT_SECRET=
FILES_BACKEND=supabase
# FLOWS_BACKEND=local

# n8n ↔ BFF flows (see docs/n8n-bff-flows.md)
# N8N_WEBHOOK_URL=https://n8n.example/webhook/crm-flow
# N8N_WEBHOOK_SECRET=
# FLOWS_TRIGGER_REQUIRE_AUTH=true
# FLOWS_TRIGGER_SERVICE_KEY=
# FLOWS_REJECT_AUTOMATION_REENTRY=true

# Legacy CMS URL/token — unused when VITE_DATA_SOURCE=graphql and DIRECTUS_RUNTIME=off
# VITE_DIRECTUS_URL=http://localhost:8055
# VITE_DIRECTUS_TOKEN=

# Platform mail only (invite, password reset, login code). Record and document email stays in n8n.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=CoreEngine <noreply@example.com>
