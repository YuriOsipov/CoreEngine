# Copied from supabase/.env + frontend .env when running locally.
# Prefer: npm run dev (loads ../supabase/.env and ../.env via dotenv paths)

PORT=4000
DATABASE_URL=postgresql://postgres:1@localhost:5434/supabase
# Explicit allowlist. In non-production, localhost/127.0.0.1 any port is also allowed.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Hasura production-records adapter (console http://localhost:8090)
HASURA_GRAPHQL_URL=http://localhost:8090/v1/graphql
HASURA_ADMIN_SECRET=myadminsecretkey

# Directus production-records adapter (GraphQL only; keep DIRECTUS_RUNTIME=off)
DIRECTUS_GRAPHQL_URL=http://localhost:8055/graphql
DIRECTUS_TOKEN=
DIRECTUS_RUNTIME=off

# n8n ↔ BFF (see docs/n8n-bff-flows.md)
# N8N_WEBHOOK_URL=https://n8n.example/webhook/crm-flow
# N8N_WEBHOOK_SECRET=
# FLOWS_TRIGGER_REQUIRE_AUTH=true
# FLOWS_TRIGGER_SERVICE_KEY=
# FLOWS_REJECT_AUTOMATION_REENTRY=true
