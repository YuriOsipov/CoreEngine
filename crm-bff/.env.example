# Copied from supabase/.env + frontend .env when running locally.
# Prefer: npm run dev (loads ../supabase/.env and ../.env via dotenv paths)

PORT=4000
# MCP Streamable HTTP at /api/v1/mcp (Claude/Cursor). See docs/mcp.md.
# MCP_HTTP_ENABLED=false
# Match supabase/.env — do not paste weak example passwords into committed files.
DATABASE_URL=
# Required for /auth/login (loaded from repo-root .env when using npm run bff:dev).
# Prefer generating via platform provision / ensure-auth-jwt-secret — placeholders are refused.
AUTH_JWT_SECRET=
# Explicit allowlist. In non-production, localhost/127.0.0.1 any port is also allowed.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Prefer repo-root .env for the full SSO list (npm run bff:dev loads it).
# AUTH_LOCAL_LOGIN_ENABLED=true
# OIDC SSO (optional) — see docs/oidc-sso.md
# OIDC_ENABLED=true
# OIDC_ISSUER=http://localhost:8081/realms/coreengine
# OIDC_INTERNAL_ISSUER=http://keycloak:8080/realms/coreengine
# OIDC_CLIENT_ID=coreengine
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:4000/auth/oidc/callback
# OIDC_UI_ORIGIN=http://localhost:5173
# OIDC_DISPLAY_NAME=Keycloak
# OIDC_SCOPES=openid profile email offline_access
# OIDC_JIT_PROVISION=false
# OIDC_DEFAULT_ROLE_BACKEND_ID=
# OIDC_ALLOWED_EMAIL_DOMAINS=example.com,acme.com
# OIDC_CHECK_ON_REFRESH=true
# OIDC_DEACTIVATE_ON_IDP_REJECT=false
# OIDC_TOKEN_ENCRYPTION_KEY=
# TRUST_PROXY=

# Hasura production-records adapter (console http://localhost:8090)
HASURA_GRAPHQL_URL=http://localhost:8090/v1/graphql
# Set a unique secret — do not commit real values or reuse example placeholders.
HASURA_ADMIN_SECRET=

# Directus production-records adapter (GraphQL only; keep DIRECTUS_RUNTIME=off)
DIRECTUS_GRAPHQL_URL=http://localhost:8055/graphql
DIRECTUS_TOKEN=
DIRECTUS_RUNTIME=off

# n8n / Activepieces ↔ BFF (see docs/n8n-bff-flows.md, docs/activepieces/README.md)
# N8N_BASE_URL=http://n8n:5678
# N8N_WEBHOOK_URL=https://n8n.example/webhook/crm-flow
# N8N_WEBHOOK_SECRET=
# N8N_ENCRYPTION_KEY=   # n8n process only (compose); keep fixed so credentials survive recreate
# ACTIVEPIECES_BASE_URL=http://activepieces:80
# ACTIVEPIECES_WEBHOOK_SECRET=   # optional; falls back to N8N_WEBHOOK_SECRET
# ACTIVEPIECES_SEED_URL=http://127.0.0.1:8081  # npm run registry:seed-activepieces-flows
# AP_EMAIL=admin@example.com
# AP_PASSWORD=
# (Minimal Compose also needs AP_ENCRYPTION_KEY / AP_JWT_SECRET / AP_POSTGRES_PASSWORD)
# FLOWS_HTTP_ALLOWED_HOSTS=n8n,n8n:5678,activepieces,activepieces:80
# FLOWS_TRIGGER_REQUIRE_AUTH=true
# FLOWS_TRIGGER_SERVICE_KEY=
# FLOWS_REJECT_AUTOMATION_REENTRY=true
