{
  "name": "crm-bff",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --exclude \"./tmp/**/*\" --exclude \"./scripts/**/*\" src/index.ts",
    "dev:stable": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "registry:import-layouts": "node --env-file=.env --env-file=supabase/.env ./scripts/import-layout-settings.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "graphql": "^16.10.0",
    "graphql-yoga": "^5.12.0",
    "nodemailer": "^10.4.0",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
