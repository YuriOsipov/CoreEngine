        "jsCode": "const routed = $input.first().json;\nconst files = Array.isArray(routed.files) ? routed.files : [];\nreturn files.map((f) => ({\n  json: {\n    messageId: routed.messageId,\n    email: routed.email,\n    subject: routed.subject,\n    body: routed.body,\n    fileId: f.id,\n    fileName: f.fileName || 'attachment.bin',\n  },\n}));"
