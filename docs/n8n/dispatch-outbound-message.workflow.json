      "parameters": {
        "jsCode": "const ctx = $('Merge message record').first().json;\nconst record = ctx.record || {};\nconst rawType = String(record.type ?? '').trim().toLowerCase();\nconst toUser = record.to_user || null;\nconst toUserId = toUser && typeof toUser === 'object' ? toUser.id : toUser;\nconst channel =\n  rawType === 'internal' || rawType === '4' || toUserId\n    ? 'internal'\n    : rawType === 'whatsapp' || rawType === '2'\n      ? 'whatsapp'\n      : rawType === 'telegram' || rawType === '3'\n        ? 'telegram'\n        : 'email';\nconst email = String(record.email || '').trim();\nlet generatedFileId = '';\ntry {\n  generatedFileId = String($('Generate PDF').first().json.outputFileId || '').trim();\n} catch (e) {}\nconst subject = String(record.subject || record.name || '').trim() || 'Message from CoreEngine';\nconst body = String(record.body || '');\nconst sendEmail = channel === 'email' && Boolean(email);\nreturn [{\n  json: {\n    messageId: ctx.messageId,\n    type: rawType || channel,\n    channel,\n    sendEmail,\n    toUserId,\n    email,\n    phone: record.phone || '',\n    subject,\n    body,\n    opportunityId: ctx.opportunityId,\n    generatedFileId,\n  },\n}];"
