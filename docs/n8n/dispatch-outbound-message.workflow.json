        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query: 'query($collection:String!,$recordId:ID!){ recordFiles(collection:$collection, recordId:$recordId, fields:[\"id\",\"title\",\"filename_download\",\"type\"]) }', variables: { collection: 'message', recordId: $json.messageId } }) }}",
