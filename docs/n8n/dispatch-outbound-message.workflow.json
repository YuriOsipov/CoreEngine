    {
      "parameters": {
        "jsCode": "const routed = $('Route payload').first().json;\nconst raw = $('List message files').first().json?.data?.recordFiles || [];\nconst list = Array.isArray(raw) ? raw : [];\nconst byId = new Map();\nfor (const f of list) {\n  if (!f) continue;\n  const id = String(f.id || f.record_id || '').trim();\n  if (!id || byId.has(id)) continue;\n  const fileName = String(\n    f.filename_download || f.title || f.filename || `file-${id.slice(0, 8)}.bin`,\n  );\n  byId.set(id, { id, fileName });\n}\nif (routed.generatedFileId && !byId.has(routed.generatedFileId)) {\n  byId.set(routed.generatedFileId, {\n    id: routed.generatedFileId,\n    fileName: 'generated.pdf',\n  });\n}\nconst files = [...byId.values()];\nreturn [{\n  json: {\n    ...routed,\n    files,\n    hasFiles: files.length > 0,\n  },\n}];"
