      "parameters": {
        "jsCode": "const ctx = $input.first().json;\nconst record = ctx.record && typeof ctx.record === 'object' ? ctx.record : ($('Merge message record').first().json.record || {});\nconst toRaw = record.to_user;\nconst toUserId = toRaw && typeof toRaw === 'object' ? String(toRaw.id || '').trim() : String(toRaw || '').trim();\nconst fromRaw = record.from_user;\nconst fromUserId = fromRaw && typeof fromRaw === 'object' ? String(fromRaw.id || '').trim() : String(fromRaw || '').trim();\nconst contactRaw = record.contact;\nconst contactId = contactRaw && typeof contactRaw === 'object' ? String(contactRaw.id || '').trim() : String(contactRaw || '').trim();\nconst oppRaw = record.opportunity;\nconst opportunityId = oppRaw && typeof oppRaw === 'object' ? String(oppRaw.id || '').trim() : String(oppRaw || '').trim();\nconst subject = String(record.subject || record.name || '').trim();\nconst body = record.body == null ? '' : String(record.body);\nconst type = String(record.type || 'internal').trim() || 'internal';\nconst fromEmail = record.from_email == null ? '' : String(record.from_email);\nconst messageId = String($('Prepare context').first().json.messageId || record.id || '').trim();\nconst name = subject || `Message ${messageId.slice(0, 8)}`;\nreturn [{\n  json: {\n    messageId,\n    toUserId,\n    hasToUser: Boolean(toUserId),\n    inboxPayload: {\n      name,\n      subject: subject || null,\n      body,\n      type,\n      from_user: fromUserId || null,\n      from_email: fromEmail || null,\n      contact: contactId || null,\n      opportunity: opportunityId || null,\n      source_message: messageId || null,\n      owner_id: toUserId || null,\n    },\n  },\n}];"
