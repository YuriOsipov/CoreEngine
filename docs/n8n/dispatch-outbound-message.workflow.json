      "parameters": {
        "jsCode": "let messageId = '';\ntry {\n  messageId = String($('Prepare context').first().json.messageId || '');\n} catch (e) {}\nif (!messageId) {\n  try {\n    messageId = String($('Merge attachments').first().json.messageId || '');\n  } catch (e) {}\n}\nif (!messageId) {\n  try {\n    messageId = String($('Resolve attachments').first().json.messageId || '');\n  } catch (e) {}\n}\nif (!messageId) {\n  throw new Error('messageId missing after email send');\n}\nreturn [{ json: { messageId, delivered: true } }];"
