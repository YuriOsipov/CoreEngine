    {
      "parameters": {
        "jsCode": "const ctx = $('Prepare context').first().json;\nconst record = ctx.record || {};\nconst type = Number(record.type ?? 0);\nconst toUser = record.to_user || null;\nconst toUserId = toUser && typeof toUser === 'object' ? toUser.id : toUser;\nconst channel =\n  type === 4 || toUserId\n    ? 'internal'\n    : type === 2\n      ? 'whatsapp'\n      : type === 3\n        ? 'telegram'\n        : 'email';\nconst email = String(record.email || '').trim();\nlet generatedFileId = '';\ntry {\n  generatedFileId = String($('Generate PDF').first().json.outputFileId || '').trim();\n} catch (e) {}\nconst subject = String(record.subject || '').trim() || 'Message from CoreEngine';\nconst body = String(record.body || '');\nconst sendEmail = channel === 'email' && Boolean(email);\nreturn [{\n  json: {\n    messageId: ctx.messageId,\n    type,\n    channel,\n    sendEmail,\n    toUserId,\n    email,\n    phone: record.phone || '',\n    subject,\n    body,\n    opportunityId: ctx.opportunityId,\n    generatedFileId,\n  },\n}];"
      },
      "id": "route-send",
