    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const routed = $('Resolve attachments').first().json;\nconst binary = {};\nconst keys = [];\nlet i = 0;\nfor (const item of $input.all()) {\n  const bin = item.binary && item.binary.data;\n  if (!bin) continue;\n  const key = `file${i}`;\n  const fileName =\n    item.json.fileName || bin.fileName || `attachment-${i + 1}.bin`;\n  binary[key] = {\n    ...bin,\n    fileName,\n    mimeType: bin.mimeType || 'application/octet-stream',\n  };\n  keys.push(key);\n  i += 1;\n}\nreturn [{\n  json: {\n    messageId: routed.messageId,\n    email: routed.email,\n    subject: routed.subject,\n    body: routed.body,\n    attachOk: keys.length > 0,\n    attachmentKeys: keys.join(','),\n    attachedCount: keys.length,\n  },\n  binary: keys.length ? binary : undefined,\n}];"
      },
