    {
      "parameters": {
        "jsCode": "const root = $('CRM Webhook').first().json;\nconst body = root.body && typeof root.body === 'object' ? root.body : root;\nconst record = body.record && typeof body.record === 'object' ? body.record : {};\nconst messageId = String(body.recordId || body.id || record.id || '').trim();\nconst opportunity = record.opportunity || body.opportunity || null;\nconst opportunityId = opportunity && typeof opportunity === 'object' ? opportunity.id : opportunity;\nconst templateId = $env.MESSAGE_DOC_TEMPLATE_ID || $env.OPPORTUNITY_QUOTE_TEMPLATE_ID || '';\nconst wantPdf = Boolean(opportunityId && templateId);\nreturn [{ json: { messageId, hasMessageId: Boolean(messageId), opportunityId, templateId, wantPdf, record, body } }];"
      },
