{
  "name": "CoreEngine — send quote PDF",
  "nodes": [
    {
      "parameters": {
        "content": "## send_quote_pdf\nWebhook path must be **ce-send_quote_pdf** (Setup → Flows target=n8n).\nCreates/patches Sales `message.delivery_status`, then generates a PDF.\nWire Settings → Error workflow → CoreEngine — failed execution alert.",
        "height": 200,
        "width": 360
      },
      "id": "note-send-quote",
      "name": "Setup note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-40, -240]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ce-send_quote_pdf",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-send-quote",
      "name": "CRM Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "ce-send_quote_pdf"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.headers['x-crm-flow-secret'] || $json.headers['X-CRM-Flow-Secret']}}",
              "value2": "={{$env.N8N_WEBHOOK_SECRET}}"
            }
          ]
        }
      },
      "id": "if-secret-quote",
      "name": "Secret OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [260, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.BFF_URL}}/auth/login",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"email\": \"{{$env.CRM_N8N_EMAIL}}\",\n  \"password\": \"{{$env.CRM_N8N_PASSWORD}}\"\n}",
        "options": {}
      },
      "id": "bff-login-quote",
      "name": "BFF Login",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, -80]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.BFF_URL}}/api/v1/message",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$json.access_token}}"
            },
            {
              "name": "X-CRM-Automation",
              "value": "n8n"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: 'Quote PDF', subject: 'Quote PDF', body: 'Quote PDF queued', type: 'email', delivery_status: 'queued', opportunity: $('CRM Webhook').item.json.body.recordId || $('CRM Webhook').item.json.recordId, ...( $('CRM Webhook').item.json.body.messageId || $('CRM Webhook').item.json.messageId ? { id: $('CRM Webhook').item.json.body.messageId || $('CRM Webhook').item.json.messageId } : {} ) }) }}",
        "options": {
          "qs": {
            "upsert": "true"
          }
        }
      },
      "id": "create-message-queued",
      "name": "Message queued",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, -80]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.BFF_URL}}/api/v1/documents/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$('BFF Login').item.json.access_token}}"
            },
            {
              "name": "X-CRM-Automation",
              "value": "n8n"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ collectionName: $('CRM Webhook').item.json.body.collection || $('CRM Webhook').item.json.collection || 'opportunity', recordId: $('CRM Webhook').item.json.body.recordId || $('CRM Webhook').item.json.recordId, templateId: $env.OPPORTUNITY_QUOTE_TEMPLATE_ID, outputFormat: 'pdf', documentStatus: 'completed', persist: true, renderOutput: true }) }}",
        "options": {}
      },
      "id": "generate-quote-pdf",
      "name": "Generate PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, -80]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.BFF_URL}}/files/{{$json.outputFileId}}/link",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$('BFF Login').item.json.access_token}}"
            },
            {
              "name": "X-CRM-Automation",
              "value": "n8n"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ parent_collection: 'message', parent_record_id: $('Message queued').item.json.id || $('Message queued').item.json.data?.id }) }}",
        "options": {}
      },
      "id": "link-quote-pdf",
      "name": "Link PDF to message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1180, -80]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{$env.BFF_URL}}/api/v1/message/{{$('Message queued').item.json.id || $('Message queued').item.json.data?.id}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$('BFF Login').item.json.access_token}}"
            },
            {
              "name": "X-CRM-Automation",
              "value": "n8n"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ delivery_status: 'sent', body: 'Quote PDF ready: ' + (($('Generate PDF').item.json.downloadUrl || $('Generate PDF').item.json.outputFileId) || 'generated') }) }}",
        "options": {}
      },
      "id": "message-sent",
      "name": "Message sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1360, -80]
    }
  ],
  "connections": {
