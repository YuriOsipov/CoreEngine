# Copy to supabase/.env for each new customer database (do not commit secrets).
# Set a strong unique POSTGRES_PASSWORD — do not leave example placeholders.

POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=kernel
POSTGRES_PASSWORD=

# Optional bootstrap user when postgres role cannot apply DDL:
# POSTGRES_BOOTSTRAP_USER=postgres
# POSTGRES_BOOTSTRAP_PASSWORD=

# Optional full URL (overrides host/port/db when set for BFF):
# DATABASE_URL=postgresql://postgres:<password>@localhost:5434/supabase
