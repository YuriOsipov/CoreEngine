        {
          "apiName": "item",
          "label": "Item",
          "type": "UUID",
          "interface": "select-dropdown-m2o",
          "required": true,
          "options": {
            "useInSearch": true
          },
          "relationKind": "M2O",
          "relatedEntity": "item",
          "relationMeta": {
            "on_delete": "CASCADE",
            "one_collection": "item"
          }
        },
        {
          "apiName": "new_price",
          "label": "New Price",
          "type": "FLOAT",
          "interface": "currency",
          "options": {
            "scale": 2,
            "precision": 18,
            "decimalPlaces": 2,
            "maxFractionDigits": 2,
            "minFractionDigits": 2
          }
        },
        {
          "apiName": "new_price_discount",
          "label": "New price discount (%)",
          "type": "FLOAT",
          "interface": "calculated",
          "readonly": true,
          "options": {
            "template": "{{ ROUND(MULTIPLY(DIVIDE(SUBTRACT( item.base_price,new_price), item.base_price), 100),0) }}",
            "computeMode": "formula"
          }
        },
        {
          "apiName": "price",
          "label": "Price",
          "type": "FLOAT",
          "interface": "currency",
          "required": true,
          "options": {
            "scale": 2,
            "suffix": "USD",
            "precision": 18,
            "decimalPlaces": 2,
            "maxFractionDigits": 2,
            "minFractionDigits": 2
          }
        },
        {
          "apiName": "price_difference",
          "label": "Price difference",
          "type": "FLOAT",
          "interface": "calculated",
          "readonly": true,
          "options": {
            "scale": 2,
            "template": "{{ SUBTRACT(price,new_price) }}",
            "precision": 18,
            "computeMode": "formula",
            "decimalPlaces": 2,
            "maxFractionDigits": 2,
            "minFractionDigits": 2
          }
        },
        {
          "apiName": "price_discount",
          "label": "Price discount (%)",
          "type": "FLOAT",
          "interface": "calculated",
          "readonly": true,
          "options": {
            "scale": 2,
            "template": "{{ MULTIPLY(DIVIDE(SUBTRACT( item.base_price,price), item.base_price), 100) }}",
            "precision": 18,
            "computeMode": "formula",
            "decimalPlaces": 2,
            "maxFractionDigits": 2,
            "minFractionDigits": 2
          }
        },
        {
